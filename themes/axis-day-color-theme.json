  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.line.double-slash"
      ],
      "settings": {
        "foreground": "#6B7084",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.modifier",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#3F4FD0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#5A6288"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.type.pinescript",
        "storage.type.qualifier",
        "entity.name.type",
        "support.type",
        "constant.language.boolean",
        "constant.language.na"
      ],
      "settings": {
        "foreground": "#2A3480"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "string.template",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#2F3E8C"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#1C1E2A"
      }
    },
    {
      "scope": [
        "support.constant.color",
        "support.constant.strategy"
      ],
      "settings": {
        "foreground": "#2A3480"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.series",
        "variable.language.barstate"
      ],
      "settings": {
        "foreground": "#3D445C"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.call",
        "support.function"
      ],
      "settings": {
        "foreground": "#2F46C8"
      }
    },
    {
      "scope": [
        "support.module",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#4A5694"
      }
    },
    {
      "scope": [
        "variable.other",
        "variable"
      ],
      "settings": {
        "foreground": "#1C1E2A"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "keyword.other.annotation",
        "string.unquoted.annotation"
      ],
      "settings": {
        "foreground": "#6B7084",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "entity.name.tag.directive"
      ],
      "settings": {
        "foreground": "#6B7084"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#6A6E7A"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C44740"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#4A5694",
    "type": "#2A3480",
    "class": "#2A3480",
    "function": "#2F46C8",
    "method": "#2F46C8",
    "variable": "#1C1E2A",
    "series": "#3F4FD0",
    "simple": "#2A3480",
    "variable.series": "#3F4FD0",
    "variable.simple": "#2A3480",
    "parameter": "#1C1E2A",
    "property": "#4E5678",
    "keyword": "#3F4FD0",
    "string": "#2F3E8C",
    "number": "#1C1E2A",
    "operator": "#5A6288",
    "comment": {
      "foreground": "#6B7084",
      "italic": true
    },
    "*.declaration": {
      "bold": true
    },
    "*.definition": {
      "bold": true
    },
    "*.readonly": {
      "foreground": "#5E6478"
    },
    "*.defaultLibrary": {
      "foreground": "#5E6478"
    }
  }
}
